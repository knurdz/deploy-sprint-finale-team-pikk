# Environment Variables Template
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is in .gitignore.
# All secret values must be stored in GitHub Secrets, not here.

# Public URL of the deployed site (safe to expose in client builds)
# Set this as a GitHub Actions Variable (vars.PUBLIC_URL), not a secret.
VITE_PUBLIC_URL=http://20.230.193.11

# The following values are managed server-side or via GitHub Secrets.
# Do not add secret values here. Use [REDACTED] as a placeholder reminder.

# Organizer deployer token — stored in GitHub Secrets as DEPLOYER_DISPATCH_TOKEN
# Value: [REDACTED] — secretsRedacted from source, managed by organizer only
DEPLOYER_DISPATCH_TOKEN=[REDACTED]

# T02 DNS Secrets - stored in GitHub Secrets
DNS_PORTAL_USERNAME=[REDACTED]
DNS_PORTAL_PASSWORD=[REDACTED]
DNS_TXT_VALUE=[REDACTED]

# T16 Resend Email Alerts — stored in GitHub Secrets only.
# NEVER prefix these with VITE_ — they must never reach the browser bundle.
RESEND_API_KEY=[REDACTED]
RESEND_FROM_EMAIL=[REDACTED]
ALERT_RECIPIENT_EMAIL=[REDACTED]
